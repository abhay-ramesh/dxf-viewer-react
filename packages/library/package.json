{
    "name": "dxf-viewer-react",
    "version": "0.2.1",
    "description": "A React component library for viewing DXF files with Three.js",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abhay-ramesh/dxf-viewer-react.git",
        "directory": "packages/library"
    },
    "homepage": "https://github.com/abhay-ramesh/dxf-viewer-react#readme",
    "bugs": {
        "url": "https://github.com/abhay-ramesh/dxf-viewer-react/issues"
    },
    "keywords": [
        "dxf",
        "cad",
        "react",
        "three.js",
        "viewer",
        "drawing",
        "autocad"
    ],
    "license": "MIT",
    "author": "abhay-ramesh",
    "main": "./dist/dxf-viewer-react.umd.js",
    "module": "./dist/dxf-viewer-react.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/dxf-viewer-react.es.js",
            "require": "./dist/dxf-viewer-react.umd.js"
        },
        "./registry/*": {
            "import": "./src/registry/*"
        }
    },
    "files": [
        "dist",
        "src/registry",
        "README.md"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "lint": "eslint .",
        "prepublishOnly": "pnpm build"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "three": ">=0.160.0"
    },
    "dependencies": {
        "dxf-parser": "^1.1.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/node": "^25.0.1",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@types/three": "^0.160.0",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.17.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^15.14.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "three": "^0.160.0",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.18.2",
        "vite": "^6.0.5",
        "vite-plugin-dts": "^4.5.4"
    }
}