{
    "name": "dxf-viewer-react",
    "version": "0.2.5",
    "description": "A React component library for viewing DXF files with Three.js",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abhay-ramesh/dxf-viewer-react.git",
        "directory": "packages/library"
    },
    "homepage": "https://github.com/abhay-ramesh/dxf-viewer-react/tree/main/packages/library#readme",
    "bugs": {
        "url": "https://github.com/abhay-ramesh/dxf-viewer-react/issues"
    },
    "keywords": [
        "dxf",
        "cad",
        "react",
        "three.js",
        "viewer",
        "drawing",
        "autocad"
    ],
    "license": "MIT",
    "author": "abhay-ramesh",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": {
                "import": "./dist/index.d.mts",
                "require": "./dist/index.d.cts"
            },
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./registry/*": {
            "import": "./src/registry/*"
        }
    },
    "files": [
        "dist",
        "src/registry",
        "README.md"
    ],
    "sideEffects": false,
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "bench": "bun run scripts/bench.ts",
        "lint": "eslint .",
        "prepublishOnly": "bun run build"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "dxf-parser": "^1.1.2",
        "three": "^0.160.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/node": "^25.0.1",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@types/three": "^0.160.0",
        "eslint": "^9.17.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^15.14.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "three": "^0.160.0",
        "tsdown": "^0.18.2",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.18.2"
    }
}